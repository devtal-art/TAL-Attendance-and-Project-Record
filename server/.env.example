# Port the server listens on. Render sets this automatically in production -
# only needed for local dev.
PORT=5000

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Comma-separated list of allowed frontend origins for CORS, e.g. your Vercel
# deployment URL(s). Leave unset in local dev to allow all origins.
# CLIENT_URL=https://your-frontend.vercel.app
# '*' works as a wildcard, e.g. to also allow Vercel's per-deployment URLs:
# CLIENT_URL=https://your-frontend.vercel.app,https://your-frontend-*.vercel.app

# Secret used to sign login tokens (JWT). REQUIRED. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid (e.g. 12h, 7d). Optional, default 12h.
# JWT_EXPIRES_IN=12h

# Initial admin account - created automatically on startup ONLY if no users
# exist yet. More users: node scripts/createUser.js <username> <password> [admin|user]
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
