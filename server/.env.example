# Port the server listens on. Render sets this automatically in production -
# only needed for local dev.
PORT=5000

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Comma-separated list of allowed frontend origins for CORS, e.g. your Vercel
# deployment URL(s). Leave unset in local dev to allow all origins.
# CLIENT_URL=https://your-frontend.vercel.app
